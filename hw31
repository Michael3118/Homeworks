-- Task 1: Display first name, last name, department number, and department name for each employee
SELECT e.first_name, e.last_name, e.department_id, d.department_name
FROM employees e
JOIN departments d ON e.department_id = d.department_id;

-- Task 2: Display first and last name, department, city, and state province for each employee
SELECT e.first_name, e.last_name, d.department_name, l.city, l.state_province
FROM employees e
JOIN departments d ON e.department_id = d.department_id
JOIN locations l ON d.location_id = l.location_id;

-- Task 3: Display first name, last name, department number, and department name for employees in departments 80 or 40
SELECT e.first_name, e.last_name, e.department_id, d.department_name
FROM employees e
JOIN departments d ON e.department_id = d.department_id
WHERE d.department_id IN (40, 80);

-- Task 4: Display all departments, including those with no employees
SELECT d.department_id, d.department_name, COUNT(e.employee_id) AS employee_count
FROM departments d
LEFT JOIN employees e ON d.department_id = e.department_id
GROUP BY d.department_id, d.department_name;

-- Task 5: Display first name of all employees, including the first name of their manager
SELECT e1.first_name AS employee_name, e2.first_name AS manager_name
FROM employees e1
LEFT JOIN employees e2 ON e1.manager_id = e2.employee_id;

-- Task 6: Display job title, full name, and the salary difference for each employee
SELECT e.first_name, e.last_name, e.job_id, 
       j.max_salary - e.salary AS salary_difference
FROM employees e
JOIN jobs j ON e.job_id = j.job_id;

-- Task 7: Display job title and average salary of employees
SELECT e.job_id, AVG(e.salary) AS average_salary
FROM employees e
GROUP BY e.job_id;

-- Task 8: Display full name, and salary of employees in departments located in London
SELECT e.first_name, e.last_name, e.salary, l.city
FROM employees e
JOIN departments d ON e.department_id = d.department_id
JOIN locations l ON d.location_id = l.location_id
WHERE l.city = 'London';

-- Task 9: Display department name and the number of employees in each department
SELECT d.department_name, COUNT(e.employee_id) AS employee_count
FROM departments d
LEFT JOIN employees e ON d.department_id = e.department_id
GROUP BY d.department_name;
